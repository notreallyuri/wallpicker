{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wallpicker",
  "version": "0.1.0",
  "identifier": "dev.wallpicker.app",
  "build": {
    "beforeDevCommand": "cd ui && trunk serve --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ui && trunk build --release",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "wallpicker",
        "width": 1100,
        "height": 760,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://th.wallhaven.cc https://w.wallhaven.cc https://konachan.net https://konachan.com https://assets.yande.re https://files.yande.re data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
